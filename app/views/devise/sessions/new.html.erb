<% content_for :title, "Sign in" %>

<div class="auth">

  <%# Left column on desktop. On phones and tablets it floats over the photo. %>
  <div class="auth-panel">
    <%= link_to "Chiaro", root_path, class: "auth-logo" %>

    <main class="auth-main">
      <header class="auth-header">
        <span class="auth-kicker">Members</span>
        <h1 class="auth-title">Welcome <em>back.</em></h1>
        <p class="auth-lede">Sign in to see your bookings, messages and credits.</p>
      </header>

      <% if alert.present? %>
        <p class="auth-flash auth-flash--alert" role="alert"><%= alert %></p>
      <% elsif notice.present? %>
        <p class="auth-flash" role="status"><%= notice %></p>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
        <%= f.label :email, class: "auth-field" do %>
          Email
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "auth-input", placeholder: "you@example.com" %>
        <% end %>

        <div class="auth-field">
          <div class="auth-field-row">
            <%= f.label :password, "Password" %>
            <% if devise_mapping.recoverable? %>
              <%= link_to "Forgot password?", new_password_path(resource_name), class: "auth-small-link" %>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password", class: "auth-input" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <%= f.label :remember_me, class: "auth-check" do %>
            <%= f.check_box :remember_me %>
            Keep me signed in
          <% end %>
        <% end %>

        <%= f.submit "Sign in", class: "auth-submit" %>
      <% end %>

      <p class="auth-switch">
        <span>New to Chiaro?</span>
        <%= link_to "Apply to join", new_registration_path(resource_name), class: "auth-ghost" %>
      </p>
    </main>

    <footer class="auth-footer">
      <span>Members only · 18+</span>
      <span>Vetted on both sides</span>
    </footer>
  </div>

  <%# Right column on desktop. Darkened full-screen background on phones and tablets. %>
  <figure class="auth-photo">
    <%= image_tag "Meli-1.jpg", alt: "", "aria-hidden": true %>
    <figcaption class="auth-photo-caption">
      <p>Made before the shoot, kept during it, credited after.</p>
      <span>FROM CHIAROSCURO — THE PLAY OF LIGHT AND SHADOW</span>
    </figcaption>
  </figure>
</div>