<h1 class="text-2xl font-bold mb-4">Request a Booking</h1>

<%= form_with model: @booking, url: bookings_path, local: true do |f| %>
  <% if @booking.errors.any? %>
    <div class="text-red-600 mb-4">
      <ul>
        <% @booking.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :photographer_id, "Photographer", class: "block font-medium mb-1" %>
    <%= f.collection_select :photographer_id, User.photographer_role.includes(:profile), :id, :display_name,
          { prompt: "Choose a photographer" }, { class: "border rounded px-3 py-2 w-full" } %>
  </div>

  <%= f.submit "Request Booking", class: "px-4 py-2 bg-black text-white rounded" %>
<% end %>