<h1 class="text-2xl font-bold mb-2">Booking Details</h1>

<div class="border rounded p-4 mb-6">
  <p><span class="font-semibold">Model:</span> <%= @booking.model.email %></p>
  <p><span class="font-semibold">Photographer:</span> <%= @booking.photographer.email %></p>
  <p><span class="font-semibold">Status:</span> <%= @booking.status.humanize %></p>
</div>

<div class="flex gap-3 mb-6">
  <% if @booking.may_confirm? && policy(@booking).confirm? %>
    <%= button_to "Confirm Booking", confirm_booking_path(@booking), method: :post, class: "px-4 py-2 bg-black text-white rounded" %>
  <% elsif @booking.may_confirm? %>
    <p class="text-gray-600">Waiting for the other party to confirm.</p>
  <% end %>

  <% if @booking.may_complete? && policy(@booking).complete? %>
    <%= button_to "Mark as Complete", complete_booking_path(@booking), method: :post, class: "px-4 py-2 bg-black text-white rounded" %>
  <% end %>
</div>

<% if @booking.feedback_pending? %>
  <% existing_feedback = @booking.feedbacks.find_by(author: current_user) %>
  <% if existing_feedback %>
    <p class="text-gray-600">You've already submitted your feedback for this booking.</p>
  <% else %>
    <%= link_to "Leave Feedback", new_booking_feedback_path(@booking), class: "inline-block px-4 py-2 bg-black text-white rounded" %>
  <% end %>
<% end %>

<% if @booking.feedbacks.any? %>
  <h2 class="text-xl font-semibold mt-6 mb-2">Feedback</h2>
  <ul class="space-y-2">
    <% @booking.feedbacks.each do |fb| %>
      <li class="border rounded p-3">
        <p class="font-medium"><%= fb.author.email %> — <%= fb.rating %>/5</p>
        <p class="text-gray-700"><%= fb.comment %></p>
      </li>
    <% end %>
  </ul>
<% end %>