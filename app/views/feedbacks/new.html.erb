<h1 class="text-2xl font-bold mb-4">Leave Feedback</h1>

<%= form_with model: @feedback, url: booking_feedbacks_path(@booking), local: true do |f| %>
  <% if @feedback.errors.any? %>
    <div class="text-red-600 mb-4">
      <ul>
        <% @feedback.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :rating, "Rating (1-5)", class: "block font-medium mb-1" %>
    <%= f.number_field :rating, in: 1..5, class: "border rounded px-3 py-2 w-24" %>
  </div>

  <div class="mb-4">
    <%= f.label :comment, class: "block font-medium mb-1" %>
    <%= f.text_area :comment, rows: 4, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= f.label :credited_name, "Credit name (optional)", class: "block font-medium mb-1" %>
    <%= f.text_field :credited_name, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <%= f.submit "Submit Feedback", class: "px-4 py-2 bg-black text-white rounded" %>
<% end %>